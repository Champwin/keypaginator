{
  "manifest_version": 3,
  "name": "键盘翻页助手 KeyPaginator",
  "version": "1.0.6",
  "description": "按方向键或自定义按键，自动点击页面上的「下一页 / 下一章 / Next」等翻页链接；内置阅读配色与对比度守护。",
  "author": "Champwin",
  "homepage_url": "https://github.com/Champwin/keypaginator",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_title": "键盘翻页助手",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contrast.js"
      ],
      "css": [
        "guard.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "keypaginator@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
